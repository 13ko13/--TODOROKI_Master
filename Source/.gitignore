# ビルド結果（コンパイルされたファイル）
*.obj
*.exe
*.dll
*.pdb
*.lib
# DxLib・Effekseerのライブラリはビルドに必要なので含める(x64用のみ)
!Dxlib_h/*_vs2015_x64_MT.lib
!Dxlib_h/*_vs2015_x64_MTd.lib
!Dxlib_h/*_vs2019_x64.lib
!Dxlib_h/*_vs2019_x64_d.lib
# Unicode版(W)はMultiByteビルドでは使わない
Dxlib_h/*W_vs2015_x64_*.lib

